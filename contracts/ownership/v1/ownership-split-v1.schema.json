{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowd.dev/contracts/ownership/ownership-split-v1.schema.json",
  "title": "MfgOwnershipSplitSnapshotV1",
  "description": "Atomic, fail-closed split snapshot. Importers must additionally enforce table-ownership.json, field-mapping.json, reference-graph.json and reconcile-rules.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source",
    "mfg_domain",
    "core_matrix_domain",
    "reconciliation",
    "excluded",
    "whole_snapshot_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "cowd.ownership-split/v1.2-final"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "mfg_domain": {
      "$ref": "#/$defs/mfgSection"
    },
    "core_matrix_domain": {
      "$ref": "#/$defs/coreSection"
    },
    "reconciliation": {
      "$ref": "#/$defs/reconciliation"
    },
    "excluded": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/excludedRecord"
      }
    },
    "whole_snapshot_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scalar": {
      "type": [
        "string",
        "integer",
        "number",
        "boolean",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "source_version",
        "schema_version",
        "exported_at",
        "maintenance_fence_id",
        "expected_legacy_schema_version",
        "ownership_contract_digest",
        "external_catalog_digest",
        "revision_baseline_digest",
        "execution_profile_digest",
        "legacy_schema"
      ],
      "properties": {
        "app_id": {
          "const": "mfg"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "exported_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "maintenance_fence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ownership_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "external_catalog_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expected_legacy_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "revision_baseline_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution_profile_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "legacy_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id",
            "schema_version",
            "updated_at",
            "disposition"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "const": 1
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "disposition": {
              "const": "validate_and_record_never_copy"
            }
          }
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_table",
        "stable_id",
        "revision",
        "source_references",
        "evidence_references",
        "payload",
        "payload_digest"
      ],
      "properties": {
        "source_table": {
          "enum": [
            "mfg_cockpit_profile",
            "mfg_cockpit_view_draft",
            "mfg_cockpit_view_proposal",
            "mfg_cockpit_view_version",
            "mfg_cockpit_view_active",
            "mfg_cockpit_report",
            "mfg_report_delivery_review",
            "mfg_report_delivery_review_transition",
            "mfg_report_delivery_review_effect_outbox",
            "mfg_alert_rule",
            "mfg_alert_occurrence",
            "mfg_alert_subscription",
            "mfg_assignment",
            "mfg_command_receipt",
            "mfg_mutation_receipt",
            "mfg_mutation_receipt_alias",
            "mfg_mutation_receipt_repair_report",
            "matrix_entity",
            "matrix_entity_source_key",
            "matrix_relation",
            "matrix_fact",
            "matrix_attention_item",
            "matrix_evidence_packet",
            "matrix_quality_gate",
            "matrix_metric_definition",
            "matrix_metric_state",
            "matrix_metric_dependency",
            "matrix_compute_job",
            "matrix_change_event",
            "mfg_incident",
            "mfg_operational_analysis",
            "mfg_action_execution",
            "mfg_memory_case",
            "mfg_playbook",
            "matrix_source_pack",
            "matrix_data_plane_watermark",
            "matrix_connector_run",
            "matrix_ontology_pack",
            "matrix_entity_match_candidate",
            "matrix_entity_conflict_decision",
            "matrix_metric_snapshot",
            "mfg_skill_execution",
            "mfg_workflow_graph"
          ]
        },
        "stable_id": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection_key",
            "axis",
            "context",
            "context_digest"
          ],
          "properties": {
            "projection_key": {
              "type": "string",
              "minLength": 1
            },
            "axis": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "context": {
              "type": "object"
            },
            "context_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "source_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "evidence_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "payload": {
          "type": "object"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sectionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "object_count",
        "section_digest",
        "objects"
      ],
      "properties": {
        "owner": {
          "enum": [
            "mfg",
            "core"
          ]
        },
        "object_count": {
          "type": "integer",
          "minimum": 0
        },
        "section_digest": {
          "$ref": "#/$defs/digest"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        }
      }
    },
    "mfgSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "owner": {
              "const": "mfg"
            }
          }
        }
      ]
    },
    "coreSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "owner": {
              "const": "core"
            }
          }
        }
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_outbox",
        "command_receipts",
        "mutation_receipts",
        "mutation_receipt_aliases",
        "mutation_receipt_repairs",
        "set_digest"
      ],
      "properties": {
        "pending_outbox": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pendingOutboxRecord"
          }
        },
        "command_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandReceiptRecord"
          }
        },
        "mutation_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutationReceiptRecord"
          }
        },
        "set_digest": {
          "$ref": "#/$defs/digest"
        },
        "mutation_receipt_aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutationAliasRecord"
          }
        },
        "mutation_receipt_repairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutationRepairRecord"
          }
        }
      }
    },
    "excludedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_table",
        "reason",
        "regeneration"
      ],
      "properties": {
        "source_table": {
          "enum": [
            "mfg_projection_event",
            "mfg_live_epoch",
            "mfg_live_secret"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmpty"
        },
        "regeneration": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_type",
        "stable_id",
        "revision",
        "payload_digest",
        "source"
      ],
      "properties": {
        "aggregate_type": {
          "type": "string",
          "minLength": 1
        },
        "stable_id": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": [
            "object",
            "null"
          ]
        },
        "payload_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table",
            "field",
            "json_pointer",
            "extractor_id"
          ],
          "properties": {
            "table": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "json_pointer": {
              "type": [
                "string",
                "null"
              ]
            },
            "extractor_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "externalReferenceCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_type",
        "stable_id",
        "revision",
        "payload_digest"
      ],
      "properties": {
        "aggregate_type": {
          "type": "string",
          "minLength": 1
        },
        "stable_id": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": [
            "object",
            "null"
          ]
        },
        "payload_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "externalReferenceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "digest",
        "owner",
        "exported_at",
        "entries"
      ],
      "properties": {
        "schema": {
          "const": "ExternalReferenceCatalogV1"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalReferenceCatalogEntry"
          }
        }
      }
    },
    "pendingOutboxRecord": {
      "title": "pending_outbox",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_ref",
        "status",
        "action",
        "effect_key",
        "attempt_count",
        "next_attempt_at",
        "last_error",
        "receipt_ref",
        "payload",
        "payload_digest"
      ],
      "properties": {
        "stable_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_attempt_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {},
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "commandReceiptRecord": {
      "title": "command_receipts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_ref",
        "status",
        "domain",
        "idempotency_key",
        "subject_ref",
        "receipt",
        "created_at",
        "payload_digest"
      ],
      "properties": {
        "stable_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt": {},
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "mutationReceiptRecord": {
      "title": "mutation_receipts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_ref",
        "status",
        "receipt_id",
        "idempotency_key",
        "actor_principal",
        "action_id",
        "resource_ref",
        "expected_revision",
        "result_revision",
        "mutation_payload_digest",
        "lease_token",
        "response",
        "contract_version",
        "created_at",
        "updated_at",
        "payload_digest"
      ],
      "properties": {
        "stable_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "result_revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mutation_payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lease_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "response": {},
        "contract_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "mutationAliasRecord": {
      "title": "mutation_receipt_aliases",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_ref",
        "status",
        "legacy_idempotency_key",
        "canonical_receipt_stable_id",
        "canonical_receipt_payload_digest",
        "created_at",
        "payload_digest"
      ],
      "properties": {
        "stable_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_receipt_stable_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_receipt_payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "mutationRepairRecord": {
      "title": "mutation_receipt_repairs",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_ref",
        "status",
        "report_id",
        "idempotency_key",
        "existing_receipt",
        "incoming_receipt",
        "existing_digest",
        "incoming_digest",
        "conflict_fields",
        "created_at",
        "payload_digest"
      ],
      "properties": {
        "stable_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "existing_receipt": {},
        "incoming_receipt": {},
        "existing_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "incoming_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
