{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowd.dev/contracts/edge/v2/schema.json",
  "title": "Cowd managed Edge v2 wire contract",
  "protocol": "cowd.edge.v2",
  "definitions": {
    "EdgeBootstrapRequest": {
      "required": ["protocol", "gateway_version", "surface_id", "driver_profile", "capabilities"],
      "properties": {
        "protocol": { "type": "string" },
        "gateway_version": { "type": "string" },
        "surface_id": { "type": "string" },
        "driver_profile": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "EdgeBootstrapResponse": {
      "required": ["protocol", "surface_id", "driver_profile", "capabilities", "max_in_flight"],
      "properties": {
        "protocol": { "type": "string" },
        "surface_id": { "type": "string" },
        "driver_profile": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "max_in_flight": { "type": "integer", "minimum": 1 }
      }
    },
    "EdgeEventEnvelope": {
      "required": ["sequence", "frame"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "frame": { "$ref": "cowd.surface.v1#/SurfaceFrame" }
      }
    },
    "EdgeEventAck": {
      "required": ["sequence"],
      "properties": { "sequence": { "type": "integer", "minimum": 0 } }
    },
    "EdgeSourceStreamMeta": {
      "required": ["chunk_index", "final_chunk"],
      "properties": {
        "chunk_index": { "type": "integer", "minimum": 0 },
        "final_chunk": { "type": "boolean" }
      }
    },
    "EdgeSourceRevision": {
      "required": ["revision"],
      "properties": {
        "expected_revision": { "type": ["integer", "null"], "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "SourceFieldSchema": { "type": "object", "required": ["name", "data_type", "nullable"] },
    "SourceTableSchema": { "type": "object", "required": ["table_name", "fields", "primary_key"] },
    "SourceBatchCursor": { "type": "object", "required": ["offset", "limit"] },
    "SourceReadPlan": { "type": "object", "required": ["adapter_id", "resource_ref"] },
    "SourceRecordBatch": { "type": "object", "required": ["adapter_id", "resource_ref", "schema", "rows", "cursor", "row_count", "checksum", "truncated"] },
    "SourceWatermark": { "type": "object", "required": ["adapter_id", "resource_ref", "strategy", "revision", "updated_at_ms"] },
    "SourceIncrementalRunRequest": {
      "type": "object",
      "required": ["adapter_id", "resource_ref"],
      "properties": {
        "adapter_id": { "type": "string" },
        "resource_ref": { "type": "string" },
        "expected_revision": { "type": ["integer", "null"], "minimum": 0 },
        "watermark": { "oneOf": [{ "$ref": "#/definitions/SourceWatermark" }, { "type": "null" }] }
      }
    },
    "SourceIncrementalRunResult": { "type": "object", "required": ["status", "chunk_index", "final_chunk"] },
    "SourceEventBatch": { "type": "object", "required": ["adapter_id", "event_count"] },
    "SourceIngestionReceipt": { "type": "object", "required": ["receipt_id", "adapter_id", "resource_ref", "row_count", "checksum", "created_at_ms"] },
    "SourceConnectorState": { "type": "object", "required": ["adapter_id", "surface_id", "status"] },
    "ManagedRuntime": {
      "required": ["kind", "artifact", "driver_profile", "transport"],
      "properties": {
        "kind": { "const": "managed" },
        "artifact": { "type": "string" },
        "driver_profile": { "type": "string" },
        "transport": { "const": "uds-http2" }
      }
    }
  }
}
