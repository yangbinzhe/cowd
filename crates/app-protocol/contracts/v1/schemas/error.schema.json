{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppErrorResponseV1",
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/$defs/AppErrorDetailV1"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error"
  ],
  "$defs": {
    "AppErrorCodeV1": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "UNAUTHENTICATED",
        "OPERATION_NOT_GRANTED",
        "APP_NOT_FOUND",
        "RECEIPT_NOT_FOUND",
        "REVISION_CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "CALL_CYCLE_DETECTED",
        "PROTOCOL_INCOMPATIBLE",
        "APP_ACTIVATION_OVERLOADED",
        "REQUEST_TOO_LARGE",
        "CURSOR_EXPIRED",
        "DEADLINE_EXCEEDED",
        "APP_UNAVAILABLE",
        "DEPENDENCY_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "AppErrorDetailV1": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/AppErrorCodeV1"
        },
        "details": {
          "default": null
        },
        "message": {
          "type": "string"
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ]
    }
  }
}
