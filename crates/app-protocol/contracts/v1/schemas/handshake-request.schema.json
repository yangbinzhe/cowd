{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppHandshakeRequestV1",
  "type": "object",
  "properties": {
    "app_id": {
      "type": "string"
    },
    "gateway_pid": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "generation": {
      "type": "string"
    },
    "protocol_revision": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "worker_pid": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_revision",
    "app_id",
    "generation",
    "gateway_pid",
    "worker_pid"
  ]
}
