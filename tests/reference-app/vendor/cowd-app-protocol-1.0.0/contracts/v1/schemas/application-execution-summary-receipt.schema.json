{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationExecutionSummaryReceiptV1",
  "type": "object",
  "properties": {
    "producer_id": {
      "type": "string"
    },
    "replayed": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "summary_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_id",
    "summary_id",
    "sequence",
    "replayed"
  ]
}
