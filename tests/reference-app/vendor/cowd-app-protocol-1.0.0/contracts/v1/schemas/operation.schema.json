{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationDescriptorV1",
  "type": "object",
  "properties": {
    "audit_classification": {
      "type": "string"
    },
    "default_deadline_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "degraded_read_allowed": {
      "type": "boolean"
    },
    "delegation": {
      "$ref": "#/$defs/OperationDelegationV1"
    },
    "idempotency": {
      "$ref": "#/$defs/IdempotencySemanticsV1"
    },
    "input_schema_digest": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/OperationKindV1"
    },
    "maximum_deadline_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "maximum_frame_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "maximum_request_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "maximum_response_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "operation_id": {
      "type": "string"
    },
    "output_schema_digest": {
      "type": "string"
    },
    "read_only": {
      "type": "boolean"
    },
    "replay_window_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "required_capability": {
      "type": "string"
    },
    "streaming": {
      "type": "boolean"
    },
    "tenant_scoped": {
      "type": "boolean"
    },
    "workspace_scoped": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "operation_id",
    "kind",
    "input_schema_digest",
    "output_schema_digest",
    "required_capability",
    "delegation",
    "tenant_scoped",
    "workspace_scoped",
    "read_only",
    "idempotency",
    "default_deadline_ms",
    "maximum_deadline_ms",
    "maximum_request_bytes",
    "maximum_response_bytes",
    "maximum_frame_bytes",
    "streaming",
    "degraded_read_allowed",
    "audit_classification"
  ],
  "$defs": {
    "IdempotencySemanticsV1": {
      "type": "string",
      "enum": [
        "read_only",
        "required",
        "subscription_cursor",
        "content_addressed"
      ]
    },
    "OperationDelegationV1": {
      "type": "string",
      "enum": [
        "user",
        "service",
        "either"
      ]
    },
    "OperationKindV1": {
      "type": "string",
      "enum": [
        "query",
        "command",
        "subscribe",
        "export"
      ]
    }
  }
}
