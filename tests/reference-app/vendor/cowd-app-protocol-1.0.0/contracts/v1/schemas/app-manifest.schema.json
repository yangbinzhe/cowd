{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppManifestV1",
  "type": "object",
  "properties": {
    "app_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "authorization_profiles": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AuthorizationProfileV1"
      }
    },
    "capabilities": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "core_bridge_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoreBridgeRequirementV1"
      }
    },
    "display_name": {
      "type": "string"
    },
    "executable": {
      "type": "string"
    },
    "integrity": {
      "$ref": "#/$defs/BundleIntegrityV1"
    },
    "operation_catalog_digest": {
      "type": "string"
    },
    "presentation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppPresentationV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_protocol": {
      "$ref": "#/$defs/ProtocolRangeV1"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxProfileV1"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "signature": {
      "$ref": "#/$defs/BundleSignatureV1"
    },
    "surfaces": {
      "$ref": "#/$defs/AppSurfacesV1"
    },
    "web_root": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "display_name",
    "artifact_version",
    "required_protocol",
    "executable",
    "operation_catalog_digest",
    "core_bridge_requirements",
    "surfaces",
    "integrity",
    "signature",
    "sandbox"
  ],
  "$defs": {
    "AppPresentationV1": {
      "type": "object",
      "properties": {
        "core_navigation_kinds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "result_contracts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AppResultContractV1"
          }
        },
        "result_shape_revision": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "tui_views": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AppTuiViewDescriptorV1"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "result_shape_revision"
      ]
    },
    "AppResultContractV1": {
      "description": "A signed, bounded structured-result contract owned by one APP.",
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string"
        },
        "max_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "schema_digest": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "contract_id",
        "schema_id",
        "schema_version",
        "schema_digest",
        "max_bytes"
      ]
    },
    "AppSurfacesV1": {
      "type": "object",
      "properties": {
        "tui_view": {
          "type": "boolean"
        },
        "web": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "web",
        "tui_view"
      ]
    },
    "AppTuiViewDescriptorV1": {
      "type": "object",
      "properties": {
        "action_operation_id": {
          "type": "string"
        },
        "open_operation_id": {
          "type": "string"
        },
        "stream_operation_id": {
          "type": "string"
        },
        "view_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "view_id",
        "open_operation_id",
        "action_operation_id",
        "stream_operation_id"
      ]
    },
    "AuthorizationProfileV1": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "display_name": {
          "type": "string"
        },
        "is_default": {
          "type": "boolean"
        },
        "profile_id": {
          "type": "string"
        },
        "surface_capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "profile_id",
        "display_name",
        "is_default"
      ]
    },
    "BundleIntegrityV1": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/IntegrityAlgorithmV1"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "manifest_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithm",
        "files",
        "manifest_digest"
      ]
    },
    "BundleSignatureV1": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/SignatureAlgorithmV1"
        },
        "expires_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "key_id": {
          "type": "string"
        },
        "provenance_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature": {
          "type": "string"
        },
        "signed_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature",
        "signed_digest"
      ]
    },
    "CoreBridgeRequirementV1": {
      "type": "object",
      "properties": {
        "accepted_input_schema_digest": {
          "type": "string"
        },
        "accepted_output_schema_digest": {
          "type": "string"
        },
        "app_operation_id": {
          "type": "string"
        },
        "core_operation_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OperationKindV1"
        },
        "required_app_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "streaming": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "app_operation_id",
        "core_operation_id",
        "accepted_input_schema_digest",
        "accepted_output_schema_digest",
        "required_app_capabilities",
        "kind",
        "streaming"
      ]
    },
    "FilesystemPolicyV1": {
      "type": "string",
      "enum": [
        "bundle_read_only_data_read_write"
      ]
    },
    "IntegrityAlgorithmV1": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "NetworkPolicyV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "deny"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string",
              "const": "capability_allowlist"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "capabilities"
          ]
        }
      ]
    },
    "OperationKindV1": {
      "type": "string",
      "enum": [
        "query",
        "command",
        "subscribe",
        "export"
      ]
    },
    "ProtocolRangeV1": {
      "type": "object",
      "properties": {
        "maximum": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minimum": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ]
    },
    "SandboxProfileV1": {
      "type": "object",
      "properties": {
        "cpu_quota_millis_per_second": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "filesystem": {
          "$ref": "#/$defs/FilesystemPolicyV1"
        },
        "max_memory_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_open_files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_processes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "network": {
          "$ref": "#/$defs/NetworkPolicyV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "max_processes",
        "max_open_files",
        "max_memory_bytes",
        "cpu_quota_millis_per_second"
      ]
    },
    "SignatureAlgorithmV1": {
      "type": "string",
      "enum": [
        "ed25519"
      ]
    }
  }
}
