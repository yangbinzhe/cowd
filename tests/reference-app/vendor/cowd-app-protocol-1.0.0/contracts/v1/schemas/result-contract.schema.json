{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppResultContractV1",
  "description": "A signed, bounded structured-result contract owned by one APP.",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "max_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "schema_digest": {
      "type": "string"
    },
    "schema_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_id",
    "schema_version",
    "schema_digest",
    "max_bytes"
  ]
}
